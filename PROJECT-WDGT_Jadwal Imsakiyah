                ramadan: [
                    { title: "Niat Sholat Isya", arabic: "اُصَلّى فَرْضَ الْعِشَاءِ اَرْبَعَ رَكَعَاتٍ مُسْتَقْبِلَ الْقِبْلَةِ اَدَاءً للهِ تَعَالَى", latin: "Ushalli fardhal-'isya'i arba'a raka'atin mustaqbilal qiblati ada'an lillahi ta'ala.", trans: "Aku niat melakukan sholat fardu isya empat rakaat sambil menghadap kiblat, saat ini, karena Allah ta'ala." },
                    { title: "Niat Sholat Tarawih", arabic: "اُصَلِّى سُنَّةَ التَّرَاوِيْحِ رَكْعَتَيْنِ مُسْتَقْبِلَ الْقِبْلَةِ لِلَّهِ تَعَالَى", latin: "Ushalli sunnatat-tarawiihi rak'ataini mustaqbilal qiblati lillahi ta'ala.", trans: "Aku niat sholat sunnah tarawih dua rakaat dengan menghadap kiblat karena Allah Ta'ala." },
                    { title: "Niat Sholat Witir", arabic: "اُصَلِّى سُنَّةَ الْوِتْرِ رَكْعَةً مُسْتَقْبِلَ الْقِبْلَةِ لِلَّهِ تَعَالَى", latin: "Ushalli sunnatal witri rak'atan mustaqbilal qiblati lillahi ta'ala.", trans: "Aku niat sholat sunnah witir satu rakaat dengan menghadap kiblat karena Allah Ta'ala." }
                ]
            },
            Sunrise: { title: "Niat Sholat Dhuha", arabic: "اُصَلِّى سُنَّةَ الضُّحَى رَكْعَتَيْنِ لِلَّهِ تَعَالَى", latin: "Ushalli sunnatadh-dhuha rak'ataini lillahi ta'ala.", trans: "Aku niat sholat sunnah dhuha dua rakaat karena Allah ta'ala." },
            Imsak: { 
                title: "Niat Puasa", 
                ramadan: { arabic: "نَوَيْتُ صَوْمَ غَدٍ عَنْ أَدَاءِ فَرْضِ شَهْرِ رَمَضَانَ هَذِهِ السَّنَةِ لِلَّهِ تَعَالَى", latin: "Nawaitu shauma ghadin 'an ada'i fardhi syahri Ramadhana hadzihis sanati lillahi ta'ala.", trans: "Aku niat berpuasa esok hari untuk menunaikan kewajiban di bulan Ramadhan tahun ini, karena Allah ta'ala." }, 
                senin: { arabic: "نَوَيْتُ صَوْمَ يَوْمِ الِاثْنَيْنِ لِلَّهِ تَعَالَى", latin: "Nawaitu shauma yaumil itsnaini lillahi ta'ala.", trans: "Aku niat berpuasa hari Senin karena Allah ta'ala." }, 
                kamis: { arabic: "نَوَيْتُ صَوْمَ يَوْمِ الْخَمِيْسِ لِلَّهِ تَعَالَى", latin: "Nawaitu shauma yaumil khamisi lillahi ta'ala.", trans: "Aku niat berpuasa hari Kamis karena Allah ta'ala." }, 
                umum: { arabic: "نَوَيْتُ الصَّوْمَ لِلَّهِ تَعَالَى", latin: "Nawaitu ash-shauma lillahi ta'ala.", trans: "Aku niat berpuasa sunnah karena Allah ta'ala." },
                tasyrik: { title: "Perbanyak Syukur", arabic: "سُبْحَانَ اللهِ وَالْحَمْدُ لِلَّهِ وَلَا اِلَهَ اِلَّا اللهُ وَاللهُ اَكْبَرُ", latin: "Subhanallahi walhamdulillah wala ilaha illallah wallahu akbar", trans: "Maha Suci Allah, segala puji bagi Allah, tidak ada Tuhan selain Allah, dan Allah adalah Maha Besar." }
            },
            EidFitr: { title: "Niat Sholat Idul Fitri", arabic: "أُصَلِّي سُنَّةً لِعِيدِ الْفِطْرِ رَكْعَتَيْنِ مُسْتَقْبِلَ الْقِبْلَةِ أَدَاءً لِلَّهِ تَعَالَى", latin: "Ushalli sunnatan li 'idil fithri rak'ataini mustaqbilal qiblati ada'an lillahi ta'ala.", trans: "Aku niat sholat sunnah Idul Fitri dua rakaat menghadap kiblat karena Allah ta'ala." },
            EidAdha: { title: "Niat Sholat Idul Adha", arabic: "أُصَلِّي سُنَّةً لِعِيدِ الْأَضْحَى رَكْعَتَيْنِ مُسْتَقْبِلَ الْقِبْلَةِ أَدَاءً لِلَّهِ تَعَالَى", latin: "Ushalli sunnatan li 'idil adha rak'ataini mustaqbilal qiblati ada'an lillahi ta'ala.", trans: "Aku niat sholat sunnah Idul Adha dua rakaat menghadap kiblat karena Allah ta'ala." }
        };

        const prayerConfig = { Imsak: "Imsak", Fajr: "Subuh", Sunrise: "Terbit", Dhuhr: "Zuhur", Asr: "Asar", Maghrib: "Magrib", Isha: "Isya" };
        let userColors = { Imsak: "#278C53", Fajr: "#32967F", Sunrise: "#32967F", Dhuhr: "#32967F", Asr: "#32967F", Maghrib: "#FF318E", Isha: "#32967F" };
        let currentTimings = null, hijriData = null, nextPrayerKey = null, currentCarouselIndex = 0;

        const clockEl = document.getElementById('real-clock');
        const masehiEl = document.getElementById('current-date-masehi');
        const hijriEl = document.getElementById('current-date-hijri');
        const banner = document.getElementById('countdown-banner');

        function isFriday() { return new Date().getDay() === 5; }
        function getEffectiveColor(key) { return (key === 'Dhuhr' && isFriday()) ? "#EB9A2A" : userColors[key]; }

        function toggleColorSettings() {
            const panel = document.getElementById('color-settings-panel');
            panel.classList.toggle('open');
            if(panel.classList.contains('open')) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function createRipple(event) {
            const container = event.currentTarget;
            const circle = document.createElement("span");
            const diameter = Math.max(container.clientWidth, container.clientHeight);
            const radius = diameter / 2;
            circle.style.width = circle.style.height = `${diameter}px`;
            circle.style.left = `${(event.clientX || event.touches[0].clientX) - container.getBoundingClientRect().left - radius}px`;
            circle.style.top = `${(event.clientY || event.touches[0].clientY) - container.getBoundingClientRect().top - radius}px`;
            circle.classList.add("ripple");
            const ripple = container.getElementsByClassName("ripple")[0];
            if (ripple) ripple.remove();
            container.appendChild(circle);
        }

        function updateTime() {
            const now = new Date();
            clockEl.innerText = now.toLocaleTimeString('id-ID', { hour12: false });
            masehiEl.innerText = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            if (currentTimings) processCalculations(now);
        }

        async function fetchJadwal(lat, lng, cityName) {
            try {
                document.getElementById('loading-state').classList.remove('hidden');
                document.getElementById('prayer-container').classList.add('hidden');
                const res = await fetch(`https://api.aladhan.com/v1/timings?latitude=${lat}&longitude=${lng}&method=20&adjustment=1`);
                const data = await res.json();
                currentTimings = data.data.timings;
                hijriData = data.data.date.hijri;
                hijriEl.innerText = `${hijriData.day} ${hijriData.month.en} ${hijriData.year} H`;
                renderCards(currentTimings);
                document.getElementById('loading-state').classList.add('hidden');
                document.getElementById('prayer-container').classList.remove('hidden');
                banner.classList.remove('hidden');
            } catch (err) { console.error(err); }
        }

        function initLocation() {
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => fetchJadwal(pos.coords.latitude, pos.coords.longitude, "GPS"),
                    () => fetchJadwal("-7.3912", "109.3638", "Purbalingga"),
                    { timeout: 5000 }
                );
            } else { fetchJadwal("-7.3912", "109.3638", "Purbalingga"); }
        }

        function renderCards(timings) {
            const container = document.getElementById('prayer-container');
            container.innerHTML = '';
            Object.entries(prayerConfig).forEach(([key, label]) => {
                const isIsha = key === 'Isha';
                const color = getEffectiveColor(key);
                let parent = container;
                if (isIsha) {
                    const group = document.createElement('div');
                    group.className = "isya-group-container col-span-2 md:col-span-1 lg:col-span-1 flex gap-2 items-stretch h-full";
                    container.appendChild(group);
                    parent = group;
                }
                const div = document.createElement('div');
                div.id = `card-${key}`;
                div.className = "glass-card p-6 flex flex-col items-center justify-center text-center prayer-card shadow-sm border-l-4 w-full h-full";
                div.style.borderLeftColor = color;
                div.innerHTML = `<p class="text-[10px] font-bold uppercase text-slate-400 tracking-tighter mb-1">${label}</p><p class="text-2xl font-black text-slate-800">${timings[key]}</p>`;
                parent.appendChild(div);
                
                if (isIsha) {
                    const btn = document.createElement('button');
                    btn.className = "bg-white border border-slate-200 rounded-2xl px-3 hover:bg-slate-50 shadow-sm transition-all text-slate-500 flex flex-col items-center justify-center gap-1 group min-w-[50px]";
                    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="group-hover:rotate-45 transition-transform duration-500" viewBox="0 0 16 16"><path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/><path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.185 1.185l-.16.291a1.873 1.873 0 0 0 1.115 2.693l.319.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.185l-.291-.16a1.873 1.873 0 0 0-2.693 1.115l-.094.319c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.693-1.115l-.291.16c-.764.415-1.6-.42-1.185-1.185l.16-.291a1.873 1.873 0 0 0-1.115-2.693l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094a1.873 1.873 0 0 0 1.115-2.693l-.16-.291c-.415-.764.42-1.6 1.185-1.185l.291.16a1.873 1.873 0 0 0 2.693-1.115l.094-.319z"/></svg><span class="text-[8px] font-black uppercase tracking-widest text-emerald-600">Atur</span>`;
                    btn.onclick = toggleColorSettings;
                    parent.appendChild(btn);
                }
            });
        }

        function processCalculations(now) {
            const prayerKeys = Object.keys(prayerConfig);
            const times = prayerKeys.map(key => {
                const [h, m] = currentTimings[key].split(':');
                const pDate = new Date(now); pDate.setHours(parseInt(h), parseInt(m), 0, 0);
                return { key, time: pDate };
            });
            let current = null;
            for (let i = times.length - 1; i >= 0; i--) if (times[i].time <= now) { current = times[i]; break; }
            let next = times.find(t => t.time > now);
            if (!next) { next = { ...times[0] }; next.time = new Date(next.time.getTime() + 24 * 60 * 60 * 1000); }
            nextPrayerKey = next.key;
            
            prayerKeys.forEach(k => {
                const card = document.getElementById(`card-${k}`);
                if (card) {
                    const color = getEffectiveColor(k);
                    if (current && k === current.key) { card.classList.add('active'); card.style.backgroundColor = color; card.style.borderLeftColor = 'transparent'; }
                    else { card.classList.remove('active'); card.style.backgroundColor = ''; card.style.borderLeftColor = color; }
                }
            });
            const nextColor = getEffectiveColor(next.key);
            document.getElementById('banner-bg').style.background = `linear-gradient(to right, ${nextColor}, ${adjustColor(nextColor, -15)})`;
            document.getElementById('next-prayer-title').innerText = prayerConfig[next.key];
            const diff = next.time - now;
            const h = Math.floor(diff / 3600000), m = Math.floor((diff % 3600000) / 60000), s = Math.floor((diff % 60000) / 1000);
            document.getElementById('countdown-timer').innerText = `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
        }

        function adjustColor(hex, percent) {
            let num = parseInt(hex.replace("#",""),16), amt = Math.round(2.55 * percent), R = (num >> 16) + amt, B = (num >> 8 & 0x00FF) + amt, G = (num & 0x0000FF) + amt;
            return "#" + (0x1000000 + (R<255?R<0?0:R:255)*0x10000 + (B<255?B<0?0:B:255)*0x100 + (G<255?G<0?0:G:255)).toString(16).slice(1);
        }

        function showNiat() {
            if (!nextPrayerKey) return;
            const modal = document.getElementById('niat-modal');
            const carouselWrapper = document.getElementById('carousel-wrapper');
            const dotsContainer = document.getElementById('carousel-dots');
            const swipeHint = document.getElementById('swipe-hint');
            
            const now = new Date();
            const day = now.getDay();
            const hDay = parseInt(hijriData.day);
            const hMonthNum = parseInt(hijriData.month.number);
            const hMonthName = hijriData.month.en;
            const isRamadan = hMonthNum === 9 || hMonthName === "Ramadan";
            const isMonday = day === 1;
            const isThursday = day === 4;
            const isEidFitr = hDay === 1 && (hMonthNum === 10 || hMonthName === "Shawwal");
            const isEidAdha = hDay === 10 && (hMonthNum === 12 || hMonthName === "Dhu al-Hijjah");
            const isTasyrik = (hDay >= 11 && hDay <= 13) && (hMonthNum === 12 || hMonthName === "Dhu al-Hijjah");

            carouselWrapper.innerHTML = ""; dotsContainer.innerHTML = "";
            dotsContainer.classList.add('hidden'); swipeHint.classList.add('hidden');
            currentCarouselIndex = 0; carouselWrapper.style.transform = "translateX(0)";

            if (nextPrayerKey === 'Maghrib' && (isRamadan || isMonday || isThursday) && !isTasyrik) {
                const maghribBase = niatData.Maghrib;
                const doaBuka = niatData.Maghrib.bukaPuasa;
                carouselWrapper.style.width = "200%";
                dotsContainer.classList.remove('hidden'); swipeHint.classList.remove('hidden');
                addSlide(carouselWrapper, doaBuka.title, doaBuka.arabic, doaBuka.latin, doaBuka.trans);
                addSlide(carouselWrapper, maghribBase.title, maghribBase.arabic, maghribBase.latin, maghribBase.trans);
                addDot(dotsContainer, 0); addDot(dotsContainer, 1);
                updateModalHeader(doaBuka.title, getEffectiveColor('Maghrib'));
            } else if (nextPrayerKey === 'Sunrise' && (isEidFitr || isEidAdha)) {
                carouselWrapper.style.width = "200%";
                dotsContainer.classList.remove('hidden'); swipeHint.classList.remove('hidden');
                const eidData = isEidFitr ? niatData.EidFitr : niatData.EidAdha;
                const dhuhaData = niatData.Sunrise;
                addSlide(carouselWrapper, eidData.title, eidData.arabic, eidData.latin, eidData.trans);
                addSlide(carouselWrapper, dhuhaData.title, dhuhaData.arabic, dhuhaData.latin, dhuhaData.trans);
                addDot(dotsContainer, 0); addDot(dotsContainer, 1);
                updateModalHeader(eidData.title, getEffectiveColor('Sunrise'));
            } else if (nextPrayerKey === 'Isha' && isRamadan) {
                const ramadanPrayers = niatData.Isha.ramadan;
                carouselWrapper.style.width = `${ramadanPrayers.length * 100}%`;
                dotsContainer.classList.remove('hidden'); swipeHint.classList.remove('hidden');
                ramadanPrayers.forEach((p, idx) => { addSlide(carouselWrapper, p.title, p.arabic, p.latin, p.trans); addDot(dotsContainer, idx); });
                updateModalHeader(ramadanPrayers[0].title, getEffectiveColor('Isha'));
            } else {
                carouselWrapper.style.width = "100%";
                let targetData = null;
                if (nextPrayerKey === 'Imsak') {
                    if (isTasyrik) targetData = niatData.Imsak.tasyrik;
                    else {
                        targetData = isRamadan ? { ...niatData.Imsak.ramadan } : (isMonday ? { ...niatData.Imsak.senin } : (isThursday ? { ...niatData.Imsak.kamis } : { ...niatData.Imsak.umum }));
                        targetData.title = niatData.Imsak.title;
                    }
                } else if (nextPrayerKey === 'Dhuhr' && day === 5) targetData = niatData.Jumat;
                else targetData = niatData[nextPrayerKey];

                if (targetData) {
                    addSlide(carouselWrapper, targetData.title, targetData.arabic, targetData.latin, targetData.trans);
                    updateModalHeader(targetData.title, getEffectiveColor(nextPrayerKey));
                }
            }
            modal.classList.add('active');
            setupSwipe();
        }

        function addSlide(parent, title, ar, lat, trans) {
            const slide = document.createElement('div'); slide.className = "carousel-slide";
            slide.innerHTML = `<div class="space-y-8"><div class="arabic-text">${ar}</div><div class="space-y-4"><div class="text-sm italic text-emerald-700 font-bold leading-relaxed bg-emerald-50/50 p-4 rounded-2xl border-l-4 border-emerald-500">${lat}</div><div class="text-[11px] text-slate-500 leading-relaxed px-2">${trans}</div></div></div>`;
            parent.appendChild(slide);
        }

        function addDot(parent, index) {
            const dot = document.createElement('div');
            dot.className = `h-1.5 w-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'dot-active' : 'bg-slate-200'}`;
            dot.style.color = getEffectiveColor(nextPrayerKey); parent.appendChild(dot);
        }

        function updateModalHeader(title, color) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-header-bg').style.backgroundColor = color;
        }

        function setupSwipe() {
            const wrapper = document.getElementById('carousel-wrapper');
            let startX = 0, currentX = 0, threshold = 50;
            wrapper.onmousedown = (e) => start(e.clientX);
            wrapper.ontouchstart = (e) => start(e.touches[0].clientX);
            function start(x) { startX = x; document.onmousemove = (e) => currentX = e.clientX; document.ontouchmove = (e) => currentX = e.touches[0].clientX; document.onmouseup = document.ontouchend = end; }
            function end() {
                const diff = startX - currentX; const totalSlides = wrapper.children.length;
                if (Math.abs(diff) > threshold && totalSlides > 1) {
                    if (diff > 0 && currentCarouselIndex < totalSlides - 1) currentCarouselIndex++;
                    else if (diff < 0 && currentCarouselIndex > 0) currentCarouselIndex--;
                    updateCarousel();
                }
                document.onmousemove = document.onmouseup = document.ontouchmove = document.ontouchend = null;
            }
        }

        function updateCarousel() {
            const wrapper = document.getElementById('carousel-wrapper');
            const dots = document.getElementById('carousel-dots').children;
            wrapper.style.transform = `translateX(-${currentCarouselIndex * 100}%)`;
            for (let i = 0; i < dots.length; i++) dots[i].className = `h-1.5 w-1.5 rounded-full transition-all duration-300 ${i === currentCarouselIndex ? 'dot-active' : 'bg-slate-200'}`;
        }

        function closeModal() { document.getElementById('niat-modal').classList.remove('active'); }
        banner.addEventListener('mousedown', createRipple);
        banner.addEventListener('touchstart', (e) => { createRipple(e); });
        banner.addEventListener('dblclick', showNiat);
        
        document.getElementById('city-selector').addEventListener('change', (e) => {
            if (e.target.value === "auto") initLocation();
            else { const [lat, lng] = e.target.value.split(','); fetchJadwal(lat, lng, e.target.options[e.target.selectedIndex].text); }
        });
        document.addEventListener('input', (e) => {
            if (e.target.classList.contains('color-picker')) { userColors[e.target.dataset.prayer] = e.target.value; if (currentTimings) renderCards(currentTimings); }
        });
        setInterval(updateTime, 1000);
        window.onload = initLocation;
    </script>

</!doctype>
