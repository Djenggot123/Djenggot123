    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&amp;family=Amiri:wght@400;700&amp;display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.25rem;
        }
        .prayer-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .prayer-card.active {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
            color: white !important;
        }
        .loader {
            border: 3px solid #f3f3f3;
            border-top: 3px solid #059669;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin-loader 1s linear infinite;
        }
        @keyframes spin-loader { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        .custom-scroll::-webkit-scrollbar { height: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        
        #niat-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 100;
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(8px);
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        #niat-modal.active { display: flex; }
        
        .modal-container {
            width: 100%;
            max-width: 500px;
            background: white;
            border-radius: 2rem;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            transform: scale(0.95);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        #niat-modal.active .modal-container {
            transform: scale(1);
            opacity: 1;
        }

        .arabic-text { 
            font-family: 'Amiri', serif; 
            font-size: 2rem; 
            line-height: 3.5rem; 
            text-align: right; 
            direction: rtl;
            color: #1e293b;
        }

        .carousel-container {
            display: flex;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .carousel-slide {
            width: 100%;
            flex-shrink: 0;
            padding: 2rem;
        }

        .dot-active {
            width: 1.5rem !important;
            background-color: currentColor !important;
        }

        .ripple-container {
            position: relative;
            overflow: hidden;
        }
        .ripple {
            position: absolute;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            transform: scale(0);
            animation: ripple-animation 0.6s linear;
            pointer-events: none;
        }
        @keyframes ripple-animation {
            to { transform: scale(4); opacity: 0; }
        }

        .spinning-pin {
            display: inline-block;
            animation: spin-y 3s linear infinite;
        }
        @keyframes spin-y {
            0% { transform: rotateY(0deg); }
            100% { transform: rotateY(360deg); }
        }

        .urgent-zone {
            position: relative;
            border: 1px solid #fecaca;
            background: white;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .urgent-zone:hover {
            border-color: #ef4444;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.1);
        }
        
        #city-selector {
            appearance: none;
            background: transparent;
            border: none;
            padding: 0 24px 0 0;
            cursor: pointer;
            text-align: center;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.025em;
            width: 100%;
            color: #ef4444;
            font-size: 0.875rem;
            z-index: 2;
        }
        #city-selector:focus { outline: none; }
        
        .select-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
        }
     

        #color-settings-panel {
            max-height: 0;
            overflow: hidden;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
        }
        #color-settings-panel.open {
            max-height: 500px;
            opacity: 1;
            margin-top: 1.5rem;
            padding: 1.5rem;
        }
    </style>



